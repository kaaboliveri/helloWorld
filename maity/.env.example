# --- Maity Configuration ---

# LLM API Keys (Required)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_API_KEY="AIza..." # Or Vertex AI service account key path

# Local System Interaction Security (Example - Implement carefully!)
# Directory Maity is allowed to operate within
LOCAL_SANDBOX_DIR="./maity_sandbox"
# Require user confirmation for dangerous actions (write, execute) - true/false
REQUIRE_CONFIRMATION_LOCAL="true"

# Deployment Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000 # If served separately

# Other configurations (e.g., database path for tasks)
TASK_DB_URL="sqlite:///./maity_tasks.db"
LOG_LEVEL="INFO"

# Model IDs (verify exact IDs from providers)
# Hypothetical ID for o3 mini
O3_MINI_MODEL_ID="o3-mini" # Replace with actual ID if known
# Claude 3.7 Sonnet ID (check latest ID)
CLAUDE_37_SONNET_MODEL_ID="claude-3.7-sonnet-20240715" # Update if needed
# Gemini 2.5 Pro ID (check latest ID and API - Vertex or AI Studio)
GEMINI_25_PRO_MODEL_ID="gemini-2.5-pro-preview-03-25" # Update if needed

# Anthropic Specific
# Default thinking budget for Claude 3.7 Sonnet
CLAUDE_THINKING_BUDGET_MS=5000 # Example: 5 seconds
